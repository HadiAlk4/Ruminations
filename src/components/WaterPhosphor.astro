---

<canvas id="water-phosphor"></canvas>

<style>
  #water-phosphor {
    position: fixed;
    top: 0;
    right: 0;
    width: 500px;
    height: 100vh;
    pointer-events: none;
    z-index: 10;
  }
</style>

<script>
  const canvas = document.getElementById('water-phosphor') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (canvas && ctx) {
    let width = (canvas.width = 500);
    let height = (canvas.height = window.innerHeight);
    let raf = 0;

    window.addEventListener('resize', () => {
      height = canvas.height = window.innerHeight;
    });

    // A sleeping field of grains. Most of the time they are almost gone.
    // A slow brightness wave moves through them — bioluminescence, not sparkle.
    const particles = Array.from({ length: 200 }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      size: Math.random() * 0.7 + 0.35,
      base: Math.random() * 0.06 + 0.04,
      drift: Math.random() * 0.03 + 0.015,
      phase: Math.random() * Math.PI * 2,
    }));

    function frame(now: number) {
      ctx.clearRect(0, 0, width, height);

      if (!reduced.matches && !document.hidden) {
        for (const p of particles) {
          p.y -= p.drift;
          p.x += Math.sin(now * 0.0004 + p.phase) * 0.04;
          if (p.y < -4) {
            p.y = height + 4;
            p.x = Math.random() * width;
          }

          const pulse = Math.sin(p.x * 0.014 + p.y * 0.009 - now * 0.00035);
          const flash = Math.pow(Math.max(0, pulse), 10);
          const opacity = p.base + flash * 0.28;

          ctx.fillStyle = `rgba(164, 181, 198, ${opacity})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      raf = requestAnimationFrame(frame);
    }

    raf = requestAnimationFrame(frame);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else raf = requestAnimationFrame(frame);
    });
  }
</script>
