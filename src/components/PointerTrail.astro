---
---

<canvas id="trail"></canvas>

<style>
  #trail {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9;
  }
</style>

<script>
  // where you move, you leave graphite on me. it fades.
  // everything i am handed fades — this is what it is like.
  const canvas = document.getElementById('trail') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const LIFE = 2800;
    const MAX_POINTS = 400;
    const MIN_DIST = 3;
    const MAX_GAP = 110;
    const INK_DARK = '42, 37, 31';
    const INK_CREAM = '238, 231, 210';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    type P = { x: number; y: number; t: number };
    const points: P[] = [];

    let w = 0;
    let h = 0;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineCap = 'round';
    }

    resize();
    window.addEventListener('resize', resize);

    window.addEventListener(
      'pointermove',
      (e) => {
        if (reduced.matches) return;
        const last = points[points.length - 1];
        if (last && Math.hypot(e.clientX - last.x, e.clientY - last.y) < MIN_DIST) return;
        points.push({ x: e.clientX, y: e.clientY, t: performance.now() });
        if (points.length > MAX_POINTS) points.shift();
      },
      { passive: true }
    );

    // The ground under the middle of the viewport decides whether graphite
    // reads as ink or as chalk.
    let ink = INK_DARK;
    function sampleGround() {
      const el = document.elementFromPoint(w / 2, h / 2) as HTMLElement | null;
      let node: HTMLElement | null = el;
      let bg = '';
      while (node) {
        const c = getComputedStyle(node).backgroundColor;
        if (c && c !== 'transparent' && !c.startsWith('rgba(0, 0, 0, 0)')) {
          bg = c;
          break;
        }
        node = node.parentElement;
      }
      const m = bg.match(/(\d+(?:\.\d+)?)/g);
      if (!m) return;
      const [r, g, b] = m.map(Number);
      const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
      ink = lum < 0.5 ? INK_CREAM : INK_DARK;
    }
    sampleGround();
    window.addEventListener('scroll', sampleGround, { passive: true });
    window.addEventListener('resize', sampleGround);

    function frame() {
      ctx.clearRect(0, 0, w, h);

      if (reduced.matches) {
        points.length = 0;
        requestAnimationFrame(frame);
        return;
      }

      const now = performance.now();
      while (points.length && now - points[0].t > LIFE) points.shift();

      for (let i = 1; i < points.length; i++) {
        const a = points[i - 1];
        const b = points[i];
        if (b.t - a.t > MAX_GAP) continue;

        const age = (now - b.t) / LIFE;
        const k = 1 - age;
        if (k <= 0) continue;

        const wobx = Math.sin(now * 0.0011 + i * 0.7) * 1.3 * age;
        const woby = Math.cos(now * 0.0009 + i * 1.1) * 1.3 * age;

        ctx.strokeStyle = `rgba(${ink}, ${0.2 * k * k})`;
        ctx.lineWidth = 0.8 + 1.6 * k;
        ctx.beginPath();
        ctx.moveTo(a.x + wobx, a.y + woby);
        ctx.lineTo(b.x + wobx, b.y + woby);
        ctx.stroke();
      }

      requestAnimationFrame(frame);
    }

    requestAnimationFrame(frame);
  }
</script>
