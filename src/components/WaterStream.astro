---
---

<canvas id="water-stream"></canvas>

<style>
  #water-stream {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }
</style>

<script>
  const canvas = document.getElementById('water-stream') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (canvas && ctx) {
    let w = 0;
    let h = 0;
    let raf = 0;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineCap = 'round';
    }

    resize();
    window.addEventListener('resize', resize);

    const HALF = 42;

    const channel = (y: number, t: number) =>
      w * 0.5 +
      Math.sin(y * 0.0036 + t * 0.0002) * Math.min(160, w * 0.14) +
      Math.sin(y * 0.01 + t * 0.00012 + 0.8) * 22;

    const spawn = (y?: number) => ({
      y: y ?? Math.random() * h,
      offset: (Math.random() + Math.random() + Math.random() - 1.5) * HALF,
      size: Math.random() * 0.7 + 0.45,
      speed: Math.random() * 0.35 + 0.22,
      opacity: Math.random() * 0.16 + 0.12,
      phase: Math.random() * Math.PI * 2,
      len: Math.random() * 7 + 5,
    });

    const particles = Array.from({ length: 170 }, () => spawn());

    function frame(now: number) {
      ctx.clearRect(0, 0, w, h);

      if (!reduced.matches && !document.hidden) {
        for (const p of particles) {
          p.y += p.speed;
          p.offset += Math.sin(now * 0.0009 + p.phase) * 0.18;
          p.offset *= 0.996;

          if (p.y > h + 10) Object.assign(p, spawn(-10));

          const cx = channel(p.y, now);
          const x = cx + p.offset;
          const edge = 1 - Math.min(1, Math.abs(p.offset) / HALF);

          ctx.strokeStyle = `rgba(164, 181, 198, ${p.opacity * (0.45 + edge * 0.55)})`;
          ctx.lineWidth = p.size;
          ctx.beginPath();
          ctx.moveTo(x, p.y);
          ctx.lineTo(
            x + Math.sin(now * 0.0018 + p.phase) * 0.9,
            p.y + p.len * (0.7 + edge * 0.5),
          );
          ctx.stroke();
        }
      }

      raf = requestAnimationFrame(frame);
    }

    raf = requestAnimationFrame(frame);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else raf = requestAnimationFrame(frame);
    });
  }
</script>
