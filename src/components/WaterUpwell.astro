---
---

<canvas id="water-upwell"></canvas>

<style>
  #water-upwell {
    position: fixed;
    top: 0;
    right: 0;
    width: 500px;
    height: 100vh;
    pointer-events: none;
    z-index: 10;
  }
</style>

<script>
  const canvas = document.getElementById('water-upwell') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (canvas && ctx) {
    let width = (canvas.width = 500);
    let height = (canvas.height = window.innerHeight);
    let raf = 0;

    window.addEventListener('resize', () => {
      height = canvas.height = window.innerHeight;
    });

    // Same micro-grains as sand, inverted: they rise, and a faint current
    // shears them sideways so the field feels liquid rather than dusty.
    const particles = Array.from({ length: 220 }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      size: Math.random() * 0.6 + 0.4,
      speed: Math.random() * 0.12 + 0.1,
      opacity: Math.random() * 0.15 + 0.12,
      phase: Math.random() * Math.PI * 2,
      freq: Math.random() * 0.0012 + 0.0006,
      amp: Math.random() * 0.28 + 0.08,
    }));

    function frame(now: number) {
      ctx.clearRect(0, 0, width, height);

      if (!reduced.matches && !document.hidden) {
        for (const p of particles) {
          p.y -= p.speed;
          p.x += Math.sin(now * p.freq + p.phase) * p.amp;

          if (p.y < -5) {
            p.y = height + 5;
            p.x = Math.random() * width;
          }
          if (p.x < -4) p.x = width + 4;
          if (p.x > width + 4) p.x = -4;

          ctx.fillStyle = `rgba(164, 181, 198, ${p.opacity})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      raf = requestAnimationFrame(frame);
    }

    raf = requestAnimationFrame(frame);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else raf = requestAnimationFrame(frame);
    });
  }
</script>
