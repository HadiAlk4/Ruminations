---
---

<canvas id="water-bubbles"></canvas>

<style>
  #water-bubbles {
    position: fixed;
    top: 0;
    right: 0;
    width: 500px;
    height: 100vh;
    pointer-events: none;
    z-index: 10;
  }
</style>

<script>
  const canvas = document.getElementById('water-bubbles') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (canvas && ctx) {
    let width = (canvas.width = 500);
    let height = (canvas.height = window.innerHeight);
    let raf = 0;

    window.addEventListener('resize', () => {
      height = canvas.height = window.innerHeight;
    });

    const spawn = () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      r: Math.random() * 1.8 + 0.6,
      speed: Math.random() * 0.22 + 0.1,
      opacity: Math.random() * 0.14 + 0.1,
      phase: Math.random() * Math.PI * 2,
      wobble: Math.random() * 0.22 + 0.05,
      ring: Math.random() > 0.62,
    });

    // Sparse on purpose — a handful of buoyant motes, not a fizzy glass.
    const particles = Array.from({ length: 42 }, spawn);

    function frame(now: number) {
      ctx.clearRect(0, 0, width, height);

      if (!reduced.matches && !document.hidden) {
        for (const p of particles) {
          p.y -= p.speed;
          p.x += Math.sin(now * 0.0009 + p.phase) * p.wobble;

          if (p.y < -8) {
            const next = spawn();
            p.x = next.x;
            p.y = height + 8;
            p.r = next.r;
            p.speed = next.speed;
            p.opacity = next.opacity;
            p.phase = next.phase;
            p.wobble = next.wobble;
            p.ring = next.ring;
          }

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          if (p.ring) {
            ctx.strokeStyle = `rgba(164, 181, 198, ${p.opacity})`;
            ctx.lineWidth = 0.7;
            ctx.stroke();
          } else {
            ctx.fillStyle = `rgba(164, 181, 198, ${p.opacity})`;
            ctx.fill();
          }
        }
      }

      raf = requestAnimationFrame(frame);
    }

    raf = requestAnimationFrame(frame);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else raf = requestAnimationFrame(frame);
    });
  }
</script>
