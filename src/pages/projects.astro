---
import SandBackground from '../components/SandBackground.astro';
import PointerTrail from '../components/PointerTrail.astro';
import Analytics from '@vercel/analytics/astro';
import { projects } from '../data/projects';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Projects</title>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=IBM+Plex+Mono&display=swap" rel="stylesheet">
    <Analytics />
    <style is:global>
      :root {
        --bg-color: #2C3E56 !important;
        --text-color: #F4F1EA !important;
        --muted-text: #A4B5C6 !important;
        --accent-white: #F4F1EA !important;
        --max-width: 650px;
      }
      body {
        background-color: var(--bg-color) !important;
        color: var(--text-color) !important;
        margin: 0;
        padding: 2rem 1.5rem 6rem 1.5rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        justify-content: center;
      }

      ::selection {
        background-color: #A4B5C6 !important;
        color: #2C3E56 !important;
        text-shadow: none !important;
      }

      ::-moz-selection {
        background-color: #A4B5C6 !important;
        color: #2C3E56 !important;
        text-shadow: none !important;
      }

      main { width: 100%; max-width: var(--max-width); }
      header {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        text-align: center !important;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        margin-bottom: 4rem;
        width: 100%;
      }
      header .logo {
        font-size: 6.5rem;
        font-family: 'EB Garamond', Georgia, serif;
        font-weight: 500;
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin-bottom: 0.8rem;
      }
      header .logo a,
      header .logo a:hover {
        color: var(--text-color) !important;
        text-decoration: none !important;
      }
      header .bio {
        color: var(--muted-text);
        font-size: 1.05rem;
        font-style: italic;
        margin: 0 0 1.5rem 0;
        max-width: 450px;
        line-height: 1.5;
      }
      header nav {
        display: flex !important;
        flex-direction: row !important;
        gap: 2rem !important;
        justify-content: center !important;
        width: 100%;
      }
      header nav a {
        color: var(--muted-text);
        text-decoration: none;
        font-size: 0.9rem;
        margin: 0 !important;
        transition: color 0.2s ease;
      }
      header nav a:hover {
        color: var(--text-color);
      }
      h1 {
        font-family: Georgia, serif;
        font-size: 3rem;
        font-weight: 400;
        margin: 0 0 0.5rem 0;
      }
      .project-count {
        color: var(--muted-text);
        font-size: 0.95rem;
        margin-bottom: 3.5rem;
      }
      .project-list {
        display: flex;
        flex-direction: column;
        gap: 2.2rem;
      }
      .project-item {
        padding-left: 0.8rem;
        border-left: 2px solid transparent;
        opacity: 0;
        transform: translateY(14px);
        transition:
          border-color 0.2s ease,
          opacity 0.9s ease var(--reveal-delay, 0ms),
          transform 0.9s ease var(--reveal-delay, 0ms);
      }
      .project-item.is-visible {
        opacity: 1;
        transform: none;
      }
      .project-item:hover,
      .project-item.is-open {
        border-left: 2px solid var(--accent-white) !important;
      }
      .project-toggle {
        display: block;
        width: 100%;
        margin: 0;
        padding: 0;
        border: none;
        background: none;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
      }
      h2.project-title {
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-size: 1.15rem;
        font-weight: 400;
        margin: 0;
      }
      .project-details {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.4s ease;
      }
      .project-item.is-open .project-details {
        grid-template-rows: 1fr;
      }
      .project-details-inner {
        overflow: hidden;
      }
      .project-description {
        color: var(--muted-text);
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-size: 0.95rem;
        font-weight: 400;
        line-height: 1.5;
        margin: 0.75rem 0 0.6rem 0;
      }
      .project-link {
        color: var(--muted-text);
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-weight: 400;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s ease;
      }
      .project-link:hover {
        color: var(--text-color);
      }
      @media (prefers-reduced-motion: reduce) {
        .project-item {
          opacity: 1;
          transform: none;
          transition: border-color 0.2s ease;
        }
        .project-details {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <SandBackground />
    <PointerTrail />
    <main>
      <header>
        <div class="logo"><a href="/">Hadi A</a></div>
        <p class="bio"></p>
        <nav>
          <a href="https://x.com/HadiAlk4">X</a>
          <a href="https://github.com/HadiAlk4">GitHub</a>
          <a href="https://www.linkedin.com/in/hadialkhub">LinkedIn</a>
          <a href="/projects">Projects</a>
        </nav>
      </header>

      <section>
        <h1>Projects</h1>
        <div class="project-count">{projects.length} projects</div>

        <div class="project-list">
          {projects.map((project, index) => (
            <article
              class="project-item"
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <button
                class="project-toggle"
                type="button"
                aria-expanded="false"
                aria-controls={`project-details-${index}`}
              >
                <h2 class="project-title">{project.title}</h2>
              </button>
              <div class="project-details" id={`project-details-${index}`}>
                <div class="project-details-inner">
                  <p class="project-description">{project.description}</p>
                  <a
                    class="project-link"
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View on GitHub
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <script>
      const items = document.querySelectorAll<HTMLElement>('.project-item');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      items.forEach((item) => {
        const toggle = item.querySelector<HTMLButtonElement>('.project-toggle');
        if (!toggle) return;

        toggle.addEventListener('click', () => {
          const open = item.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(open));
        });
      });

      if (reduceMotion) {
        items.forEach((item) => item.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );

        items.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
