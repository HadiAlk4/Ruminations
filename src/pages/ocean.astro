---
import { getCollection } from 'astro:content';
import SandBackground from '../components/SandBackground.astro';
import WaterUpwell from '../components/WaterUpwell.astro';
import WaterBubbles from '../components/WaterBubbles.astro';
import WaterCaustics from '../components/WaterCaustics.astro';
import WaterRipples from '../components/WaterRipples.astro';
import WaterPhosphor from '../components/WaterPhosphor.astro';
import WaterStream from '../components/WaterStream.astro';
import WaterBanks from '../components/WaterBanks.astro';
import PointerTrail from '../components/PointerTrail.astro';
import { url } from '../lib/url';
import Analytics from '@vercel/analytics/astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

const studies = [
  {
    id: 'sand',
    label: 'sand',
    note: 'the current grain fall, for reference',
  },
  {
    id: 'upwell',
    label: 'upwell',
    note: 'the inverse — micro-motes rising on a slow current',
  },
  {
    id: 'bubbles',
    label: 'bubbles',
    note: 'sparse buoyant rings and motes, still on the right edge',
  },
  {
    id: 'caustics',
    label: 'caustics',
    note: 'faint threads of light, like sun through water',
  },
  {
    id: 'ripples',
    label: 'ripples',
    note: 'a still pool, barely disturbed',
  },
  {
    id: 'phosphor',
    label: 'phosphor',
    note: 'a sleeping field, with a slow bioluminescent pulse',
  },
  {
    id: 'stream',
    label: 'stream',
    note: 'a single current, meandering down the page',
  },
  {
    id: 'banks',
    label: 'banks',
    note: 'two currents rising at the edges, the middle left still',
  },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Ocean studies</title>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet">
    <Analytics />
    <style is:global>
      :root {
        --bg-color: #2C3E56 !important;
        --text-color: #F4F1EA !important;
        --muted-text: #A4B5C6 !important;
        --accent-white: #F4F1EA !important;
        --max-width: 650px;
      }
      body {
        background-color: var(--bg-color) !important;
        color: var(--text-color) !important;
        margin: 0;
        padding: 2rem 1.5rem 6rem 1.5rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        justify-content: center;
      }

      ::selection {
        background-color: #A4B5C6 !important;
        color: #2C3E56 !important;
        text-shadow: none !important;
      }

      ::-moz-selection {
        background-color: #A4B5C6 !important;
        color: #2C3E56 !important;
        text-shadow: none !important;
      }

      main { width: 100%; max-width: var(--max-width); }
      header {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        text-align: center !important;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        margin-bottom: 4rem;
        width: 100%;
      }
      header .logo {
        font-size: 6.5rem;
        font-family: 'EB Garamond', Georgia, serif;
        font-weight: 500;
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin-bottom: 0.8rem;
      }
      header .logo a,
      header .logo a:hover {
        color: var(--text-color) !important;
        text-decoration: none !important;
      }
      header nav {
        display: flex !important;
        flex-direction: row !important;
        gap: 2rem !important;
        justify-content: center !important;
        width: 100%;
      }
      header nav a {
        color: var(--muted-text);
        text-decoration: none;
        font-size: 0.9rem;
        margin: 0 !important;
        transition: color 0.2s ease;
      }
      header nav a:hover {
        color: var(--text-color);
      }
      h1 {
        font-family: Georgia, serif;
        font-size: 3rem;
        font-weight: 400;
        margin: 0 0 0.5rem 0;
      }
      .post-count {
        color: var(--muted-text);
        font-size: 0.95rem;
        margin-bottom: 3.5rem;
      }
      .post-list {
        display: flex;
        flex-direction: column;
        gap: 2.2rem;
      }
      .post-item {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        padding-left: 0.8rem;
        border-left: 2px solid transparent;
        transition: border-color 0.2s ease;
      }
      .post-item:hover {
        border-left: 2px solid var(--accent-white) !important;
      }
      .post-date {
        color: var(--muted-text);
        font-size: 0.85rem;
        margin-bottom: 0.2rem;
      }
      .post-title {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0;
      }
      .post-item:hover .post-title {
        text-decoration: none !important;
        color: var(--text-color) !important;
      }

      .study-picker {
        position: fixed;
        left: 1.5rem;
        bottom: 1.5rem;
        z-index: 20;
        pointer-events: auto;
        max-width: 220px;
      }
      .study-picker .kicker {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 1.05rem;
        color: var(--text-color);
        margin: 0 0 0.55rem 0;
        letter-spacing: 0.01em;
      }
      .study-picker nav {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.28rem;
      }
      .study-picker a {
        color: var(--muted-text);
        text-decoration: none;
        font-size: 0.82rem;
        transition: color 0.2s ease;
      }
      .study-picker a:hover,
      .study-picker a[aria-current="page"] {
        color: var(--text-color);
      }
      .study-picker a[aria-current="page"] {
        font-style: italic;
      }
      .study-layer {
        display: none;
      }
      .study-layer.is-on {
        display: block;
      }
      .study-note {
        color: var(--muted-text);
        font-size: 0.75rem;
        font-style: italic;
        line-height: 1.4;
        margin: 0.7rem 0 0 0;
        max-width: 200px;
      }

      @media (max-width: 900px) {
        .study-picker {
          left: 1rem;
          right: 1rem;
          bottom: 0;
          max-width: none;
          padding: 0.7rem 0 0.9rem;
          background: var(--bg-color);
        }
        .study-picker nav {
          flex-direction: row;
          flex-wrap: wrap;
          gap: 0.7rem 1.1rem;
        }
        .study-note { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="study-layer" data-study="sand"><SandBackground /></div>
    <div class="study-layer is-on" data-study="upwell"><WaterUpwell /></div>
    <div class="study-layer" data-study="bubbles"><WaterBubbles /></div>
    <div class="study-layer" data-study="caustics"><WaterCaustics /></div>
    <div class="study-layer" data-study="ripples"><WaterRipples /></div>
    <div class="study-layer" data-study="phosphor"><WaterPhosphor /></div>
    <div class="study-layer" data-study="stream"><WaterStream /></div>
    <div class="study-layer" data-study="banks"><WaterBanks /></div>
    <PointerTrail />
    <main>
      <header>
        <div class="logo"><a href={url('/')}>Hadi A</a></div>
        <nav>
          <a href="https://x.com/HadiAlk4">X</a>
          <a href="https://github.com/HadiAlk4">GitHub</a>
          <a href="https://www.linkedin.com/in/hadialkhub">LinkedIn</a>
          <a href={url('/projects')}>Projects</a>
        </nav>
      </header>

      <section>
        <h1>All Posts</h1>
        <div class="post-count">{sortedPosts.length} posts</div>

        <div class="post-list">
          {sortedPosts.map((post) => (
            <a href={url(`/blog/${post.slug || post.id}`)} class="post-item">
              <span class="post-date">{formatDate(post.data.pubDate)}</span>
              <h2 class="post-title">{post.data.title}</h2>
            </a>
          ))}
        </div>
      </section>
    </main>

    <aside class="study-picker" aria-label="Background studies">
      <p class="kicker">studies</p>
      <nav>
        {studies.map((study) => (
          <a href={`?v=${study.id}`} data-study-link={study.id}>
            {study.label}
          </a>
        ))}
      </nav>
      <p class="study-note" data-study-note></p>
    </aside>

    <script define:vars={{ studies }}>
      const ids = studies.map((s) => s.id);
      const notes = Object.fromEntries(studies.map((s) => [s.id, s.note]));

      function read() {
        const v = new URLSearchParams(window.location.search).get('v');
        return ids.includes(v) ? v : 'upwell';
      }

      function apply(id) {
        document.querySelectorAll('[data-study]').forEach((el) => {
          el.classList.toggle('is-on', el.getAttribute('data-study') === id);
        });
        document.querySelectorAll('[data-study-link]').forEach((el) => {
          if (el.getAttribute('data-study-link') === id) el.setAttribute('aria-current', 'page');
          else el.removeAttribute('aria-current');
        });
        const note = document.querySelector('[data-study-note]');
        if (note) note.textContent = notes[id] ?? '';
        window.dispatchEvent(new Event('resize'));
      }

      apply(read());

      document.querySelectorAll('[data-study-link]').forEach((el) => {
        el.addEventListener('click', (event) => {
          event.preventDefault();
          const id = el.getAttribute('data-study-link');
          if (!id) return;
          const next = new URL(window.location.href);
          next.searchParams.set('v', id);
          history.pushState({}, '', next);
          apply(id);
        });
      });

      window.addEventListener('popstate', () => apply(read()));
    </script>
  </body>
</html>
